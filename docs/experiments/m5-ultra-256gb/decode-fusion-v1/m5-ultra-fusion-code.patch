diff --git a/tutorial_code/miniengine/engine/packed_decode.py b/tutorial_code/miniengine/engine/packed_decode.py
new file mode 100644
index 0000000..139dbe2
--- /dev/null
+++ b/tutorial_code/miniengine/engine/packed_decode.py
@@ -0,0 +1,65 @@
+"""Derived decode weights, owned by the runner rather than model parameters.
+
+Concatenate output rows once: the same NVFP4 dot products need fewer launches.
+Original parameter arrays stay intact; replacement refreshes the derived copy.
+"""
+import itertools
+
+import mlx.core as mx
+
+from ..model.layers import Linear
+
+
+class PackedProjection:
+    def __init__(self, *ops):
+        self.ops = ops
+        self.splits = list(itertools.accumulate(op.out_features for op in ops))[:-1]
+        self.arrays = []
+        self.sources = ()
+
+    def current_sources(self):
+        return tuple(a for op in self.ops for a in (op.weight, op.scales))
+
+    def supported(self):
+        return all(type(op) is Linear
+                   and op.q == {"group_size": 16, "bits": 4, "mode": "nvfp4"}
+                   and op.in_features == 5120 and op.out_features % 16 == 0
+                   and op.weight.shape == (op.out_features, 640) and op.weight.dtype == mx.uint32
+                   and op.scales.shape == (op.out_features, 320) and op.scales.dtype == mx.uint8
+                   and getattr(op, "biases", None) is None for op in self.ops)
+
+    def __call__(self, x):
+        y = mx.quantized_matmul(x, *self.arrays, transpose=True,
+                                group_size=16, bits=4, mode="nvfp4")
+        return mx.split(y, self.splits, axis=-1)
+
+
+class PackedDecode:
+    def __init__(self, model):
+        self.layers = []
+        for layer in model.layers:
+            mlp = PackedProjection(layer.mlp.gate_proj, layer.mlp.up_proj)
+            if layer.is_attn:
+                a = layer.self_attn
+                mixer = PackedProjection(a.q_proj, a.k_proj, a.v_proj)
+            else:
+                a = layer.linear_attn
+                mixer = PackedProjection(a.in_proj_qkv, a.in_proj_z, a.in_proj_b, a.in_proj_a)
+            self.layers.append((mlp, mixer))
+        self.groups = [p for layer in self.layers for p in layer]
+        # Keep this outer tree stable: mx.compile captures it as mutable inputs.
+        self.arrays = [p.arrays for p in self.groups]
+
+    def refresh(self):
+        changed = [(p, p.current_sources()) for p in self.groups]
+        changed = [(p, sources) for p, sources in changed
+                   if len(sources) != len(p.sources)
+                   or any(a is not b for a, b in zip(sources, p.sources))]
+        if any(not p.supported() for p, _ in changed):
+            return False
+        for p, sources in changed:
+            p.arrays[:] = [mx.concatenate(sources[::2]), mx.concatenate(sources[1::2])]
+            p.sources = sources
+        if changed:
+            mx.eval([p.arrays for p, _ in changed])
+        return True
diff --git a/tutorial_code/miniengine/kernels/gdn_decode_fused.py b/tutorial_code/miniengine/kernels/gdn_decode_fused.py
new file mode 100644
index 0000000..852df80
--- /dev/null
+++ b/tutorial_code/miniengine/kernels/gdn_decode_fused.py
@@ -0,0 +1,43 @@
+"""B1 convolution, BF16 activation and serial GDN norms in one preparation pass.
+
+Keep BF16 rounding at every convolution addition, as in MLX's column sum.
+The existing norm-reuse state kernel retains the original reduction order.
+"""
+import mlx.core as mx
+from . import gdn_norm_reuse_metal as nr
+HEADER=nr.HEADER+r'''
+inline float prepared_column(uint c, const device bfloat16_t* raw,
+        const device bfloat16_t* conv, const device bfloat16_t* w,
+        device bfloat16_t* new_conv) {
+    bfloat16_t p0 = conv[c] * w[4*c];
+    bfloat16_t p1 = conv[10240+c] * w[4*c+1];
+    bfloat16_t p2 = conv[20480+c] * w[4*c+2];
+    bfloat16_t p3 = raw[c] * w[4*c+3];
+    bfloat16_t s = p0 + p1;
+    s += p2; s += p3;
+    bfloat16_t u = bfloat16_t(s);
+    new_conv[c] = conv[10240+c];
+    new_conv[10240+c] = conv[20480+c];
+    new_conv[20480+c] = raw[c];
+    return float(v18_bf16_activation(u).activated);
+}
+'''
+source=nr._PREWORK_SOURCE
+for index in ('h * 128 + lane','2048 + h * 128 + lane','4096 + h * 128 + lane'):
+    source=source.replace('float(v18_bf16_activation(u['+index+']).activated)',
+                          'prepared_column('+index+', raw, conv, w, new_conv)')
+assert 'u[' not in source
+kernel=mx.fast.metal_kernel(name='gdn_decode_conv_prework_bf16', input_names=['raw','conv','w'],
+    output_names=['q_ready','k_ready','v_ready','scales','new_conv'],source=source,header=HEADER,
+    compile_options=nr.COMPILE_OPTIONS)
+def fused(raw,conv,w,g,beta,S):
+    if not (raw.shape == (1,10240) and conv.shape == (1,3,10240) and w.shape == (10240,4)
+            and raw.dtype == conv.dtype == w.dtype == mx.bfloat16):
+        raise ValueError("fused GDN requires the qualified B1 BF16 convolution")
+    nr._validate_shapes(raw,g,beta,S)
+    nr._validate_dtypes(raw,g,beta,S,mx)
+    q,k,v,scales,new_conv=kernel(inputs=[raw,conv,w],grid=(64*128,1,1),threadgroup=(128,1,1),
+       output_shapes=[(1,16,128),(1,16,128),(1,48,128),(1,16,2),(1,3,10240)],
+       output_dtypes=[mx.float32]*4+[mx.bfloat16])
+    o,state=nr._state(q,k,v,scales,g,beta,S,mx)
+    return o,state,new_conv
