+def export_profile(native, out, name, sampled, request_index, reference_map):
+    raw = native.lib.v63_profile_json()
+    assert raw, "missing native profile JSON"
+    path = out / ("raw-profile-" + name + ".json")
+    path.write_bytes(raw)  # Preserve every row before validating; never filter invalid samples.
+    value = json.loads(raw)
+    assert value["sampled"] == sampled and value["request"] == request_index and value["step"] == 1
+    assert value["segments"] == len(value["rows"]) == 1625
+    assert value["CB_GPUStartTime_seconds"] > 0 and value["CB_GPUEndTime_seconds"] >= value["CB_GPUStartTime_seconds"]
+    pso_names = {r["function"] for r in native.report("native-profile-" + name)["feedback"]["icb"]["PSO_records"]}
+    ordinal_map, counts = [], {}
+    for j, row in enumerate(value["rows"]):
+        assert row["ICB_ordinal"] == j and row["PSO"] in pso_names and row["sampled"] == sampled
+        assert row["category"] == category(row["PSO"])
+        assert isinstance(row["bindings"], list) and len({b["index"] for b in row["bindings"]}) == len(row["bindings"])
+        for b in row["bindings"]:
+            assert b["index"] >= 0 and b["original_buffer"] >= 0 and b["offset"] >= 0
+            base64.b64decode(b["bytes_payload_base64"], validate=True)
+        if sampled:
+            assert row["valid"] is True, ("invalid sampled row; STOP, raw preserved", name, j, row)
+            assert row["raw_start"] > 0 and row["raw_end"] >= row["raw_start"]
+            assert row["raw_delta"] == row["raw_end"] - row["raw_start"]
+        else:
+            assert row["valid"] is False and row["raw_start"] == row["raw_end"] == 0 and row["raw_delta"] is None
+        ordinal_map.append({k: row[k] for k in ("ICB_ordinal", "PSO", "category", "bindings")})
+        counts[row["category"]] = counts.get(row["category"], 0) + 1
+    if reference_map is None: reference_map = ordinal_map
+    else: assert ordinal_map == reference_map, "actual captured command/binding map changed between requests"
+    return {"request": name, "step": 1, "sampled": bool(sampled),
