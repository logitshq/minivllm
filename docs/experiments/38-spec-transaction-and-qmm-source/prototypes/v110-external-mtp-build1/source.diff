--- candidate44/tutorial_code/miniengine/model/qwen3_5.py
+++ candidate110/tutorial_code/miniengine/model/qwen3_5.py
@@ -91,3 +91,23 @@
     def lm_head_fn(self, h: mx.array) -> mx.array:
         """给 drafter 用的输出头（drafter 自己没有 lm_head，借目标模型的）。"""
         return self.embed_tokens.as_linear(h) if self.cfg.tie_word_embeddings else self.lm_head(h)
+
+    def forward_with_hidden(self, input_ids: mx.array, ctx=None, last_only: bool = False):
+        """Explicit V110 B1 seam: (logits, final-normalized hidden).
+
+        Original __call__ remains unchanged. No speculative routing is enabled.
+        Each row is one token of a single sequence (or B1 decode).
+        """
+        if type(last_only) is not bool:
+            raise TypeError("last_only must be a strict bool")
+        if input_ids.ndim != 1 or input_ids.size < 1:
+            raise ValueError("one nonempty token vector required")
+        if ctx is not None and (ctx.mode not in ("prefill", "decode")
+                                or (ctx.mode == "decode" and input_ids.shape != (1,))):
+            raise ValueError("V110 hidden seam supports singleton sequence/decode only")
+        x = self.embed_tokens(input_ids)
+        for i, layer in enumerate(self.layers):
+            x = layer(x, ctx, i)
+        x = x[-1:] if last_only else x
+        hidden = self.norm(x)
+        return self.lm_head_fn(hidden), hidden
