+    def _four_projection_eligible(self, x):
+        if not object.__getattribute__(self, "_four_projection_enabled"):
+            return False
+        helper = object.__getattribute__(self, "_four_projection_helper")
+        if helper is None or x.shape != (1,5120) or x.dtype != mx.bfloat16:
+            return False
+        ops = self._four_projection_ops()
+        expected = {"group_size":16, "bits":4, "mode":"nvfp4"}
+        valid = True
+        for j,(op,n) in enumerate(zip(ops,(10240,6144,48,48))):
+            if (type(op) is not Linear or type(op.q) is not dict or op.q != expected
+                    or op.in_features != 5120 or op.out_features != n
+                    or hasattr(op,"bias") or hasattr(op,"biases")
+                    or op.weight is not helper.operands[2*j]
+                    or op.scales is not helper.operands[2*j+1]
+                    or op.weight.shape != (n,640) or op.weight.dtype != mx.uint32
+                    or op.scales.shape != (n,320) or op.scales.dtype != mx.uint8):
+                valid = False
+                break
+        if not valid:
+            # Drop stale owners after replacement/reload; fallback uses current arrays.
+            object.__setattr__(self, "_four_projection_helper", None)
+            object.__setattr__(self, "_four_projection_x_strides", None)
+        return valid
