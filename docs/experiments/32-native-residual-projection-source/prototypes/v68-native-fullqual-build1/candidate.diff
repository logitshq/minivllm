+    def prepare_four_projection(self, *, observed_weight_scale_strides, observed_x_strides,
+                                runtime_version, device_name, architecture, input_layout_contract):
+        """Caller independently probes live operands and one actual norm output first.
+
+        This is preparation, outside capture/replay/timing. Subsequent engine X
+        comes from the unchanged original input-layernorm row-major output kernel;
+        arbitrary caller-supplied arrays are outside this explicitly qualified API.
+        """
+        if (input_layout_contract != "qualified-original-input-layernorm-B1"
+                or len(observed_x_strides) != 2 or observed_x_strides[1] != 1):
+            raise ValueError("observed B1 unit-K-stride input-layernorm output required")
+        ops = self._four_projection_ops()
+        expected = {"group_size":16, "bits":4, "mode":"nvfp4"}
+        if any(type(op) is not Linear or type(op.q) is not dict or op.q != expected
+               or op.in_features != 5120 or op.out_features != n
+               or hasattr(op, "bias") or hasattr(op, "biases")
+               for op,n in zip(ops, (10240,6144,48,48))):
+            raise ValueError("original four NVFP4 Linear operators required")
+        from ..kernels.v66_four_projection.four_projection import prepare
+        operands = tuple(v for op in ops for v in (op.weight, op.scales))
+        helper = prepare(mx, operands, observed_strides=observed_weight_scale_strides,
+                         runtime_version=runtime_version, device_name=device_name,
+                         architecture=architecture)
+        object.__setattr__(self, "_four_projection_helper", helper)
+        object.__setattr__(self, "_four_projection_x_strides", tuple(observed_x_strides))
