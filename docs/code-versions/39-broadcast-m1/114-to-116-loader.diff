+def _load_drafter_bounded116(model_dir, quantize, stage_observer):
+    """Same per-tensor quantization; bound live materialized source lifetime.
+
+    mx.load returns lazy arrays. Keep only string keys for traversal, pop each
+    source owner, evaluate all quantized siblings together, then release it.
+    Required unquantized norm/codebook owners remain in out unchanged.
+    """
+    cfg = DraftConfig.from_dir(model_dir)
+    model = DFlash2Drafter(cfg, quantize)
+    weights = mx.load(str(Path(model_dir) / "model.safetensors"))
+    out = {}
+    if stage_observer is not None:
+        stage_observer("lazy_header_loaded", {"source_tensors": len(weights)})
+    for index, original_key in enumerate(tuple(weights)):
+        v = weights.pop(original_key)
+        k = original_key.replace("candidate_selector.hidden_projection", "selector_proj").replace("candidate_selector.", "")
+        is_quantized = quantize is not None and k.endswith(".weight") and v.ndim == 2 and ("proj" in k or k.startswith("fc.") or "mlp." in k)
+        if is_quantized:
+            w, scales, biases = mx.quantize(v, group_size=quantize["group_size"], bits=quantize["bits"], mode=quantize["mode"])
+            mx.eval(w, scales, biases)
+            base = k[: -len(".weight")]
+            out[k], out[base + ".scales"], out[base + ".biases"] = w, scales, biases
+        else:
+            out[k] = v
+        source_metadata = {"index": index, "original_key": original_key, "name": k,
+                           "source_shape": list(v.shape), "source_dtype": str(v.dtype),
+                           "quantized": is_quantized, "unprocessed_lazy_sources": len(weights)}
+        del v
+        if stage_observer is not None:
+            stage_observer("source_released_after_triple_eval", source_metadata)
+    if weights:
+        raise RuntimeError("bounded loader left source owners unprocessed")
+    model.load_weights(list(out.items()), strict=True)
+    mx.eval(model.parameters())
+    if stage_observer is not None:
+        stage_observer("strict_model_loaded_eval", {"source_tensors": 81, "output_parameters": len(out)})
+    return model
